# Copy to .env (git-ignored). Both keys are optional: without them EternalAI
# writes template-based incident reports.
GEMINI_API_KEY=
GROQ_API_KEY=

# watch-only | ask-first | autopilot (empty: the rulebook's mode)
ETERNALAI_MODE=ask-first

# Rulebook (policy YAML). Empty: eternalai/rulebooks/default.yaml (the plan's values).
# benchmark-v2.yaml reproduces the policy of the measured benchmark-v2 system.
ETERNALAI_POLICY_FILE=

# Token required by the approval API (Approve/Reject). Set your own.
ETERNALAI_APPROVAL_TOKEN=change-me

# Token the evaluator uses to inject faults into the shop services. REQUIRED: the stack refuses to start
# while it is empty, and the services refuse the old published default 'evaluator-only'. Set a long random value.
CHAOS_TOKEN=
